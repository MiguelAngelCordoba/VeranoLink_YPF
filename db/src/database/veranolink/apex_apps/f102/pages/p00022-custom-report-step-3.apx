                    --   execute immediate 'CREATE OR REPLACE VIEW VISTAFEA  AS ('|| l_query ||')';
                    --   l_query := 'select * from "RENOBO"."VIEW_ASD"';
                      
                    APEX_COLLECTION.CREATE_COLLECTION_FROM_QUERY (
                        p_collection_name   => 'AUTO',
                        p_query           =>  l_query,
                        p_truncate_if_exists => 'YES');
                        :P22_VALIDATE_QUERY := 1;
                        EXCEPTION WHEN OTHERS THEN 
                        :P22_VALIDATE_QUERY := 0;
                    END;
