    pageItem P22_VALIDATE_QUERY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        source {
            used: always
        }
    )

    button cancelar (
        buttonName: Cancelar
        label: Cancelar
        layout {
            sequence: 20
            region: @ver-datos-contenidos-en-la-consulta
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button siguiente (
        buttonName: Siguiente
        label: Siguiente
        layout {
            sequence: 10
            region: @ver-datos-contenidos-en-la-consulta
            slot: create
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button volver (
        buttonName: Volver
        label: Volver
        layout {
            sequence: 10
            region: @ver-datos-contenidos-en-la-consulta
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction da-cancel-delete (
        name: DA_CANCEL_DELETE
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    
                    BEGIN
                    EXECUTE IMMEDIATE 'DROP VIEW '||:GET_COMPANY_NAME||'.VIEW_'||UPPER(:CUSTOM_REPORT_NAME);
                    COMMIT;
                    EXCEPTION WHEN OTHERS THEN 
                    NULL;
                    END;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction da-drop-view (
        name: DA_DROP_VIEW
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @volver
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    
                    BEGIN
                    EXECUTE IMMEDIATE 'DROP VIEW '||:GET_COMPANY_NAME||'.VIEW_'||UPPER(:CUSTOM_REPORT_NAME);
                    COMMIT;
                    EXCEPTION WHEN OTHERS THEN 
                    NULL;
                    END;
                    ```
                itemsToSubmit: [
                    CUSTOM_REPORT_NAME
                    GET_COMPANY_NAME
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 21
                }
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction da-validate-query (
        name: DA_VALIDATE_QUERY
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P22_VALIDATE_QUERY
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @siguiente
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P22_VALIDATE_QUERY
                value: 1
            }
        )

        action plugin-de-danielh-toastrnotifications (
            action: plugin/toastrNotifications
            settings {
                type: error
                text: Tu consulta no retorna informacion, por favor valida los tipos de datos y/o filtros de la consulta
                preventDuplicates: true
                extendedTimeout: 10000
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P22_VALIDATE_QUERY
                value: 1
            }
        )

    )

