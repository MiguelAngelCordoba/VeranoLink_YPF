page 22 (
    name: Custom Report - Step 3
    alias: CUSTOM-REPORT-STEP-3
    title: Crear Reporte Personalizado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        attributes: closeOnEscape:false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            var button = parent.$('.ui-dialog-titlebar-close'); //get the button
            button.hide(); //hide the button
            console.log(button)
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lista-de-progreso (
        name: Lista de progreso
        type: list
        source {
            list: @flow-custom-report
        }
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region ver-datos-contenidos-en-la-consulta (
        name: Ver datos contenidos en la consulta
        type: classicReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                
                v_query VARCHAR2(1000);
                BEGIN
                v_query := 'SELECT * FROM "'||:GET_COMPANY_NAME||'"."VIEW_'||UPPER(:CUSTOM_REPORT_NAME)||'"';
                RETURN v_query;
                
                
                END;
                ```
            useGenericColumnNames: true
            genericColumnCount: 100
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: reporte
        }
        reportLayout {
            numberOfRows: 4
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
            displayPosition: bottomLeft
        }
        messages {
            whenNoDataFound:
                ```
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Página de Ejemplo</title>
                    <script>
                        // Definición de la función
                        function mensajeAutomatico() {
                            apex.event.trigger(document,'hideitem');
                        }
                    </script>
                </head>
                <body onload="mensajeAutomatico();">
                    <h3>No hay datos acá :( </h3>
                </body>
                </html>
                
                ```
        }
        heading {
            type: columnNames
        }

