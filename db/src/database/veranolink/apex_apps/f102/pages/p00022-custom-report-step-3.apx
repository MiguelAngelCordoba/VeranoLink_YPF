    process update-shutle (
        name: update_shutle
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    cursor col_csr is
                        select seq_id
                        from apex_collections
                        where collection_name = 'COLUMNS';
                    col_rec col_csr%ROWTYPE;
                    shtl apex_application_global.vc_arr2;
                begin
                    -- Loop through the collection, setting display sequence to null and
                    -- display in report to N. We'll clean up in a bit.
                    for col_rec in col_csr loop
                        apex_collection.update_member_attribute(
                            p_collection_name => 'COLUMNS',
                            p_seq => col_rec.seq_id,
                            p_attr_number => 4,
                            p_number_value => null );
                        apex_collection.update_member_attribute(
                            p_collection_name => 'COLUMNS',
                            p_seq => col_rec.seq_id,
                            p_attr_number => 5,
                            p_attr_value => 'N' );
                    end loop;
                    -- Now, go through the shuttle's values, setting the display
                    -- flag and sequence properly.
                    shtl := apex_util.string_to_table( :P22_COLUMNS );
                    for i in 1..shtl.COUNT loop
                        apex_collection.update_member_attribute(
                            p_collection_name => 'COLUMNS',
                            p_seq => shtl(i),
                            p_attr_number => 4,
                            p_number_value => i );
                        apex_collection.update_member_attribute(
                            p_collection_name => 'COLUMNS',
                            p_seq => shtl(i),
                            p_attr_number => 5,
                            p_attr_value => 'Y' );
                    end loop;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 14092931491118904
        }
        serverSideCondition {
            type: never
        }
    )

