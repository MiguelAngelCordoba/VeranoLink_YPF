    process spactualizarusuario (
        name: spActualizarUsuario
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                l_elements varchar2(50);
                
                BEGIN
                IF :GET_ROL = 1 THEN 
                VL_PKG_CRUD_USER.UPDATE_USER (:P9_NAME, :P9_EMAIL,:P9_VL_ID_COMPANY_SA, :P9_VL_ID_ROL_SA, :P9_STATE, :P9_VL_ID_USER);
                ELSIF :GET_ROL = 2 THEN
                VL_PKG_CRUD_USER.UPDATE_USER (:P9_NAME, :P9_EMAIL, :GET_COMPANY, :P9_VL_ID_ROL_AD, :P9_STATE, :P9_VL_ID_USER);
                END IF;
                
                
                select listagg(:P9_SL_SOURCES, ':') into l_elements from dual;
                
                VL_PKG_CRUD_USER.UPDATE_USER_SOURCES(l_elements, :P9_VL_ID_USER);
                
                
                END;
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Usuario actualizado
        }
        advanced {
            executionMappingIdentifier: 3205064969819531
        }
        serverSideCondition {
            whenButtonPressed: @actualizar
        }
    )

    process spcrearusuario (
        name: spCrearUsuario
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                DECLARE
                
                    l_elements varchar2(50);
                    v_id number;
                
                BEGIN
                
                    IF :GET_ROL = 1 THEN 
                        v_id := VL_PKG_CRUD_USER.NEW_USER (:P9_NAME, :P9_EMAIL, :P9_PASSWORD, :P9_VL_ID_COMPANY_SA, :P9_VL_ID_ROL_SA);
                
                    ELSIF :GET_ROL = 2 THEN
                        v_id := VL_PKG_CRUD_USER.NEW_USER (:P9_NAME, :P9_EMAIL, :P9_PASSWORD, :GET_COMPANY, :P9_VL_ID_ROL_AD);
                        select listagg(:P9_SL_SOURCES, ':') into l_elements from dual;
                        VL_PKG_CRUD_USER.UPDATE_USER_SOURCES(l_elements, v_id);
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Usuario Creado
        }
        advanced {
            executionMappingIdentifier: 3203542031819516
        }
        serverSideCondition {
            whenButtonPressed: @crear
        }
    )

)

