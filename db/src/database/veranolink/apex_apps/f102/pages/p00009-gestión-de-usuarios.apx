    pageItem P9_SL_SOURCES (
        type: checkboxGroup
        label {
            label: Ambientes
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                
                    C.NAME||' - '||D.TYPE_ENVIRONMENT AS D, A.ID_VL_SOURCE 
                    FROM VL_SOURCES A 
                
                INNER JOIN VL_COMPANIES_SOURCE_APPLICATIONS B ON A.ID_VL_COMPANY_APPLICATION = B.ID_VL_COMPANY_APPLICATION
                INNER JOIN VL_SOURCE_APPLICATIONS C ON B.ID_VL_SOURCE_APPLICATION = C.ID_VL_SOURCE_APPLICATION
                INNER JOIN VL_TYPES_ENVIRONMENT D ON D.ID_VL_TYPE_ENVIRONMENT = A.ID_VL_TYPE_ENVIRONMENT 
                WHERE B.VL_ID_COMPANY = :GET_COMPANY ;
                ```
        }
        layout {
            sequence: 120
            region: @gestión-de-usuarios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: SELECT listagg(ID_VL_SOURCE_ENVIRONMENT, ':' ) within group (order by ID_VL_SOURCE_ENVIRONMENT) FROM vl_SOURCE_ASSIGNS WHERE ID_VL_USER=:P9_VL_ID_USER
            used: always
        }
    )

