    validation vldt-user-exist (
        name: VLDT_USER_EXIST
        execution {
            sequence: 120
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                COUNTER NUMBER;
                BEGIN
                SELECT COUNT(*) INTO COUNTER FROM VL_USERS WHERE EMAIL =UPPER(:P9_EMAIL);
                
                IF COUNTER != 0 THEN
                    RETURN 'Ya existe un usuario con este email!';
                
                  END IF;
                
                
                END;
                ```
        }
        error {
            associatedItem: @P9_EMAIL
        }
        serverSideCondition {
            whenButtonPressed: @crear
        }
    )

