            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region gestión-de-usuarios (
        name: Gestión de Usuarios
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select VL_ID_USER,
                       NAME,
                       EMAIL,
                       PASSWORD,
                       VL_ID_COMPANY,
                       CREATED_DATE,
                       VL_ID_ROL,
                       STATE
                  from VL_USERS
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

