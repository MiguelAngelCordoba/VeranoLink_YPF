    dynamicAction ad-validate (
        name: AD_VALIDATE
        execution {
            sequence: 100
        }
        when {
            event: click
            selectionType: button
            button: @actualizar-trabajo
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        v_job_name        VARCHAR2(100) := :P29_JOB_NAME;       -- Nombre del job
                        v_new_state       VARCHAR2(5) := :P29_ENABLED;          -- Estado: 'TRUE' o 'FALSE'
                        v_new_interval    VARCHAR2(4000) := :P29_REPEAT_INTERVAL; -- Nuevo repeat_interval
                        v_job_interval    NUMBER;                               -- Intervalo proporcionado
                    BEGIN
                        -- Validar que P29_JOB_INTERVAL sea un número
                        v_job_interval := TO_NUMBER(TRIM(:P29_JOB_INTERVAL));
                    
                        -- Validar que P29_JOB_INTERVAL esté entre 1 y 100
                        IF v_job_interval >= 1 AND v_job_interval <= 99 THEN
                    
                            --:P29_VALIDATOR := v_job_interval;
                            -- Actualizar el estado del job
                            IF v_new_state = 'FALSE' THEN
                                DBMS_SCHEDULER.DISABLE(name => v_job_name);
                            ELSE
                                DBMS_SCHEDULER.ENABLE(name => v_job_name);
                            END IF;
                    
                            -- Actualizar el repeat_interval
                            DBMS_SCHEDULER.SET_ATTRIBUTE(
                                name      => v_job_name,
                                attribute => 'repeat_interval',
                                value     => v_new_interval
                            );
                    
                            -- Actualizar el comentario
                            DBMS_SCHEDULER.SET_ATTRIBUTE(
                                name      => v_job_name,
                                attribute => 'comments',
                                value     => :P29_DESCRIPTION
                            );
                    
                            -- Configurar la hora de inicio a la hora actual + 1 minuto
                            DBMS_SCHEDULER.SET_ATTRIBUTE(
                                name      => v_job_name,
                                attribute => 'start_date',
                                value     => SYSTIMESTAMP + INTERVAL '1' MINUTE
                            );
                    
                            :P29_VALIDATOR := 1;
                        ELSE
                            -- Si no cumple con la validación, asignar 0 a P29_VALIDATOR
                            :P29_VALIDATOR := 0;
                        END IF;
                    
                    EXCEPTION
                        WHEN VALUE_ERROR THEN
                            -- Si ocurre un error de conversión, asignar 0 a P29_VALIDATOR
                            :P29_VALIDATOR := 2;
                        WHEN OTHERS THEN
                            -- Manejo general de errores
                            :P29_VALIDATOR := 0;
                    END;
                    ```
                itemsToSubmit: [
                    P29_JOB_NAME
                    P29_ENABLED
                    P29_REPEAT_INTERVAL
                    P29_DESCRIPTION
                    P29_JOB_INTERVAL
                ]
                itemsToReturn: P29_VALIDATOR
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

