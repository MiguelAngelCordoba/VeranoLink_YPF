    pageItem P29_JOB_FREQ (
        type: selectList
        label {
            label: Frecuencia de repetición
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Cada minuto;Minutely,Cada hora;Hourly,Diariamente;Daily,Semanalmente;Weekly,Mensualmente;Monthly,Anualmente;Yearly
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @información-del-trabajo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT 
                       CASE
                           WHEN repeat_interval LIKE '%FREQ=WEEKLY%' THEN 'Weekly'
                           WHEN repeat_interval LIKE '%FREQ=DAILY%' THEN 'Daily'
                           WHEN repeat_interval LIKE '%FREQ=YEARLY%' THEN 'Yearly'
                           WHEN repeat_interval LIKE '%FREQ=MONTHLY%' THEN 'Monthly'
                           WHEN repeat_interval LIKE '%FREQ=HOURLY%' THEN 'Hourly'
                           WHEN repeat_interval LIKE '%FREQ=MINUTELY%' THEN 'Minutely'
                           ELSE 'Unknown'
                       END AS frequency
                FROM   user_scheduler_jobs where job_name = :P29_JOB_NAME;
                ```
        }
