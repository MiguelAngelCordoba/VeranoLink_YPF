    dynamicAction da-refresh-freq-year (
        name: DA_REFRESH_FREQ_YEAR
        execution {
            sequence: 120
        }
        when {
            selectionType: items
            items: P29_JOB_FREQ
        }
        clientSideCondition {
            type: item=value
            item: P29_JOB_FREQ
            value: Yearly
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P29_JOB_DAYS
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item=value
                item: P29_JOB_FREQ
                value: Yearly
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P29_JOB_DAYS
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
            clientSideCondition {
                type: item!=value
                item: P29_JOB_FREQ
                value: Yearly
            }
        )

    )

    dynamicAction da-update-freq (
        name: DA_UPDATE_FREQ
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: [
                P29_JOB_FREQ
                P29_JOB_INTERVAL
                P29_JOB_DAYS
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var repeat_interval = "";
                    
                    if ($v("P29_JOB_FREQ").length > 0) {
                        repeat_interval = repeat_interval + "FREQ=" + $v("P29_JOB_FREQ").trim().toUpperCase() + "; ";
                    }
                    
                    // Solo concatena BYDAY si la frecuencia no es "YEARLY"
                    if ($v("P29_JOB_FREQ").trim().toUpperCase() !== "YEARLY" && $v("P29_JOB_DAYS").length > 0) {
                        repeat_interval = repeat_interval + "BYDAY=" + $v("P29_JOB_DAYS").replace(/:/g, ",") + "; ";
                    }
                    
                    if ($v("P29_JOB_INTERVAL").length > 0) {
                        repeat_interval = repeat_interval + "interval=" + $v("P29_JOB_INTERVAL") + "; ";
                    }
                    
                    $s("P29_REPEAT_INTERVAL", repeat_interval);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

