    )

    dynamicAction darefreshitemjson (
        name: DaRefreshItemJson
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P29_ID_LOG
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P29_JSON
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction openjsonview (
        name: OpenJsonView
        execution {
            sequence: 60
            eventScope: dynamic
            staticContainer: #Vsdt
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .cc-clear-btn
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    
                    (function () {
                      var parameterValue = $v("P29_JSON");
                    
                      $(".my_json_item").empty(); // Limpiar contenido previo
                    
                      if (!parameterValue || parameterValue.trim() === "") {
                        document.querySelector(".my_json_item").textContent = "No se usaron parámetros.";
                      } else {
                        document.querySelector(".my_json_item").textContent = parameterValue;
                    
                        try {
                          var json = JSON.parse(parameterValue);
                    
                        
                          $(".my_json_item").JSONView(json, { collapsed: true }); 
                    
                          
                          $("#expandBtn").on("click", function (event) {
                            event.preventDefault(); 
                            $(".my_json_item").JSONView('expand'); // Expande todo el JSON
                          });
                    
                     
                          $("#collapseBtn").on("click", function (event) {
                            event.preventDefault(); 
                            $(".my_json_item").JSONView('collapse'); // Colapsa todo el JSON
                          });
                         
                        } catch (e) {
                          console.error("El valor no es un JSON válido:", e);
                        }
                      }
                    })();
                    
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function() {
                      var parameterValue = $v("P29_VL_PARAMETERS");
                    
                      $(".my_json_item").empty();
                    
                    
                      if (!parameterValue || parameterValue.trim() === "") {
                        document.querySelector(".my_json_item").textContent = "No se usaron parámetros.";
                      } else {
                        // Asigna el valor a la región <pre>
                        document.querySelector(".my_json_item").textContent = parameterValue;
                    
                        try {
                          // Intentar formatear el JSON
                          var json = JSON.parse(parameterValue);
                          $(".my_json_item").JSONView(json, { collapsed: false });
                        } catch (e) {
                          console.error("El valor no es un JSON válido:", e);
                        }
                      }
                    })();
                    
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @ver-json
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression:
                    ```javascript-browser
                    $(this.triggeringElement).data('id');
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P29_ID_LOG
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                       RETURN CONVERT_BLOB_TO_CLOB(:P29_ID_LOG);
                    END;
                    
                    ```
                itemsToSubmit: [
                    P29_JSON
                    P29_ID_LOG
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P29_JSON
            }
            execution {
                sequence: 30
            }
        )

    )

)

