page 34 (
    name: LOG OPC
    alias: LOG-OPC
    title: Detalle de Ejecución
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region log-opc (
        name: LOG OPC
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT LOS.ID_LOG,
                       LOS.CONTRACT_NUMBER,
                       LOS.TIPO_OBJETO,
                       LOS.OBJECT_CODE,
                       LOS.OBJECT_NAME,
                       LOS.UPDATE_SINCRONIZADO,
                       LOS.ACCION,
                       CAST(FROM_TZ(LOS.FECHA_EJECUCION, 'UTC') AT TIME ZONE 'America/Bogota' AS TIMESTAMP) AS FECHA_EJECUCION,
                       LOS.RESULTADO,
                       LOS.HIERARCHY_PATH_ID,
                       LOS.ID_LOTE
                  FROM LOG_OPC_SEQUENCE LOS
                  JOIN (
                        SELECT *
                          FROM USER_SCHEDULER_JOB_RUN_DETAILS
                         WHERE LOG_ID = :P34_LOG_ID
                       ) RUN
                    ON FROM_TZ(LOS.FECHA_EJECUCION, 'UTC')
                         >= RUN.actual_start_date
                   AND FROM_TZ(LOS.FECHA_EJECUCION, 'UTC')
                         <= RUN.actual_start_date + RUN.run_duration
                 ORDER BY LOS.FECHA_EJECUCION DESC;
                ```
            pageItemsToSubmit: P34_LOG_ID
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 2496024845644315
        }

        column ACCION (
            type: plainText
            heading {
                heading: Accion
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column CONTRACT_NUMBER (
            type: plainText
            heading {
                heading: Contract Number
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column FECHA_EJECUCION (
            type: plainText
            heading {
                heading: Fecha Ejecucion
            }
            layout {
                sequence: 80
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
        )

        column HIERARCHY_PATH_ID (
            type: plainText
            heading {
                heading: Hierarchy Path Id
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ID_LOG (
            type: plainText
            heading {
                heading: Id Log
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_LOTE (
            type: plainText
            heading {
                heading: Lote
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column OBJECT_CODE (
            type: plainText
            heading {
                heading: Object Code
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column OBJECT_NAME (
            type: plainText
            heading {
                heading: Object Name
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column RESULTADO (
            type: plainText
            heading {
                heading: Resultado
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column TIPO_OBJETO (
            type: plainText
            heading {
                heading: Tipo Objeto
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column UPDATE_SINCRONIZADO (
            type: plainText
            heading {
                heading: Update Sincronizado
            }
            layout {
                sequence: 60
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCION (
                sequence: 6
            )

            displayColumn CONTRACT_NUMBER (
                sequence: 1
            )

            displayColumn FECHA_EJECUCION (
                sequence: 7
            )

            displayColumn HIERARCHY_PATH_ID (
                sequence: 9
            )

            displayColumn ID_LOTE (
                sequence: 10
            )

            displayColumn OBJECT_CODE (
                sequence: 3
            )

            displayColumn OBJECT_NAME (
                sequence: 4
            )

            displayColumn RESULTADO (
                sequence: 8
            )

            displayColumn TIPO_OBJETO (
                sequence: 2
            )

            displayColumn UPDATE_SINCRONIZADO (
                sequence: 5
            )

        )

    )

    pageItem P34_JOB_NAME (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P34_LOG_ID (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    button atrás (
        buttonName: Atrás
        label: Atrás
        layout {
            sequence: 10
            region: @log-opc
            slot: CREATE
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 29
                items: {
                    P29_NAME_JOB: &P34_JOB_NAME.
                }
                request: VIEW_LOGS
            }
        }
    )

)

