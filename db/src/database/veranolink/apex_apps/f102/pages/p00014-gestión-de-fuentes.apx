                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P14_RESPONSE
                value: 0
            }
            config {
                buildOption: @commented-out
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode: UPDATE VL_SOURCES SET VL_SOURCE_STATE = 0 WHERE ID_VL_SOURCE = :P14_ID_VL_SOURCE;
                itemsToSubmit: P14_ID_VL_SOURCE
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P14_RESPONSE
                value: 0
            }
            config {
                buildOption: @commented-out
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

        action plugin-de-danielh-toastrnotifications (
            action: plugin/toastrNotifications
            settings {
                type: success
                text: Conexión existosa
                preventDuplicates: true
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P14_RESPONSE
                value: 1
            }
        )

        action plugin-de-danielh-toastrnotifications-2 (
            action: plugin/toastrNotifications
            settings {
                type: error
                text: Conexión fallida
                preventDuplicates: true
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P14_RESPONSE
                value: 0
            }
        )

        action plugin-de-danielh-toastrnotifications-3 (
            action: plugin/toastrNotifications
            settings {
                text: No se puede eliminar, porque se esta usando en otras tablas
                preventDuplicates: true
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 100
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P14_RESPONSE
                value: 2
            }
        )

    )

    dynamicAction da-update-url (
        name: DA_UPDATE_URL
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @actualizar
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression:
                ```javascript-browser
                (apex.item('P14_ID_VL_COMPANY_APPLICATION').getValue() !=="" && apex.item('P14_SOURCE_URL').getValue() !=="" && apex.item('P14_USER').getValue() !==""
                && apex.item('P14_PASS').getValue() !=="" && apex.item('P14_VL_TYPE_ENVIRONMENT').getValue() !=="")
                ```
        }

        action native-alert (
            action: alert
            settings {
                message: Conexión exitosa.
                style: success
                okLabel: Aceptar
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P14_RESPONSE
                value: 1
            }
        )

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 50
                fireOnInit: false
            }
            config {
                buildOption: @commented-out
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        ENCODE64            VARCHAR2(15000 CHAR);
                        GET_ALIAS           VARCHAR2(1500 CHAR);
                        VALIDATOR           BOOLEAN;
                        TOKEN_EXISTS        NUMBER;
                    
                    BEGIN
                        -- Codificar usuario y contraseña en Base64
                        SELECT vl_pkg_utl_base64.vl_fn_encode_base64("SYS"."UTL_RAW"."CAST_TO_RAW"(:P14_USER || ':' || :P14_PASS)) 
                        INTO ENCODE64 
                        FROM dual;
                    
                        -- Obtener el alias de la aplicación fuente
                        SELECT VSA.ALIAS 
                        INTO GET_ALIAS
                        FROM VL_SOURCE_APPLICATIONS VSA
                        INNER JOIN VL_COMPANIES_SOURCE_APPLICATIONS VCSA
                            ON VSA.ID_VL_SOURCE_APPLICATION = VCSA.ID_VL_SOURCE_APPLICATION 
                        WHERE VCSA.ID_VL_COMPANY_APPLICATION = :P14_ID_VL_COMPANY_APPLICATION;
                    
                        -- Verificar si el ambiente configurado
                        SELECT COUNT(*)
                        INTO TOKEN_EXISTS
                        FROM 
                            VL_SOURCE_APPLICATIONS A
                            INNER JOIN VL_COMPANIES_SOURCE_APPLICATIONS B
                                ON A.ID_VL_SOURCE_APPLICATION = B.ID_VL_SOURCE_APPLICATION
                            INNER JOIN VL_SOURCES C
                                ON B.ID_VL_COMPANY_APPLICATION = C.ID_VL_COMPANY_APPLICATION
                            INNER JOIN VL_COMPANIES G
                                ON G.VL_ID_COMPANY = B.VL_ID_COMPANY
                            INNER JOIN VL_SOURCE_COLLECTIONS D
                                ON D.ID_VL_SOURCE_APPLICATION = A.ID_VL_SOURCE_APPLICATION
                            INNER JOIN VL_PATH_CONTEXTS E
                                ON D.ID_VL_SOURCE_COLLECTION = E.ID_VL_SOURCE_COLLECTION
                            INNER JOIN VL_CALL_TYPES F
                                ON F.ID_VL_CALL_TYPE = E.ID_VL_CALL_TYPE
                        WHERE 
                            B.ID_VL_COMPANY_APPLICATION = :P14_ID_VL_COMPANY_APPLICATION 
                            AND G.SHORT_NAME = :GET_COMPANY_NAME
                            AND C.ID_VL_TYPE_ENVIRONMENT = :P14_VL_TYPE_ENVIRONMENT 
                            AND C.SOURCE_AUTHENTICATION IS NOT NULL
                            AND E.NAME = 'Get Token'
                            AND ID_VL_SOURCE != :P14_ID_VL_SOURCE;
                    
                        IF TOKEN_EXISTS > 0 THEN
                    
                            :P14_RESPONSE := 3; -- Si existe un ambiente configurado (Que no sea el mismo que se esta actualizando) se retorna el valor 3 con el fin de mostrar la notificación
                    
                        ELSE
                            -- Validar si la conexción es correcta
                            VALIDATOR := VL_PKG_REST_SERVICES.VL_FN_VALIDATE_SOURCE(GET_ALIAS, :GET_COMPANY_NAME, :P14_VL_TYPE_ENVIRONMENT, ENCODE64, :P14_SOURCE_URL);
                    
                            IF VALIDATOR = True THEN
                                :P14_RESPONSE := 1;
                                UPDATE VL_SOURCES
                                SET 
                                    ID_VL_COMPANY_APPLICATION = :P14_ID_VL_COMPANY_APPLICATION,
                                    SOURCE_URL = :P14_SOURCE_URL,
                                    SOURCE_AUTHENTICATION = ENCODE64,
                                    ID_VL_TYPE_ENVIRONMENT = :P14_VL_TYPE_ENVIRONMENT
                                WHERE 
                                    ID_VL_SOURCE = :P14_ID_VL_SOURCE;
                    
                                COMMIT;
                            ELSE
                                :P14_RESPONSE := 0;
                            END IF;
                        END IF;
                    END;
                    ```
                itemsToSubmit: [
                    P14_ID_VL_SOURCE
                    P14_ID_VL_COMPANY_APPLICATION
                    P14_SOURCE_URL
                    P14_USER
                    P14_PASS
                    P14_ID_VL_WS_TYPE
                    P14_VL_TYPE_ENVIRONMENT
                ]
                itemsToReturn: P14_RESPONSE
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                spinnerType: ellipsis
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            config {
                buildOption: @commented-out
            }
        )

        action plugin-de-danielh-toastrnotifications (
            action: plugin/toastrNotifications
            settings {
                type: warning
                text: Ingrese todos los datos
                preventDuplicates: true
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action plugin-de-danielh-toastrnotifications-2 (
            action: plugin/toastrNotifications
            settings {
                type: error
                text: La configuración para este entorno ya se encuentra registrada.
                preventDuplicates: true
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P14_RESPONSE
                value: 3
            }
        )

    )

    dynamicAction da-value-pass-user (
        name: DA_VALUE_PASS_USER
        execution {
            sequence: 70
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_ID_VL_SOURCE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    V_MAIN_VALUE CLOB;
                    v_convert_value CLOB;
                    BEGIN
                    SELECT SOURCE_AUTHENTICATION INTO V_MAIN_VALUE FROM VL_SOURCES WHERE ID_VL_SOURCE= :P14_ID_VL_SOURCE;
                    v_convert_value:=VL_PKG_CONVERT_BLOBCLOB.CLOBFROMBLOB(VL_PKG_UTL_BASE64.VL_FN_DECODE_BASE64(V_MAIN_VALUE));
                    :P14_USER:= SUBSTR(v_convert_value, 1, INSTR(v_convert_value, ':') - 1);
                    
                    :P14_PASS:= SUBSTR(v_convert_value, INSTR(v_convert_value, ':') + 1);
                    
                    END;
                    ```
                itemsToSubmit: P14_ID_VL_SOURCE
                itemsToReturn: [
                    P14_USER
                    P14_PASS
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

