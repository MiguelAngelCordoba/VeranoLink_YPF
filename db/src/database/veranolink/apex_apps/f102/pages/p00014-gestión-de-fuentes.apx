    dynamicAction da-delete-action (
        name: DA_DELETE_ACTION
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @delete
        }

        action native-alert (
            action: alert
            settings {
                message: ¿Desea eliminar el registro?
                style: danger
                okLabel: Confirmar
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    DELETE FROM VL_SOURCES WHERE ID_VL_SOURCE = :P14_ID_VL_SOURCE;
                    EXCEPTION WHEN OTHERS THEN 
                     IF SQLCODE = -02292 THEN 
                        :P14_RESPONSE := 2;
                        ELSE 
                        NULL;
                        END IF;
                    END;
                    ```
                itemsToSubmit: P14_ID_VL_SOURCE
                itemsToReturn: P14_RESPONSE
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction da-notification (
        name: DA_NOTIFICATION
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P14_RESPONSE
        }

        action native-dialog-close (
            action: closeDialog
