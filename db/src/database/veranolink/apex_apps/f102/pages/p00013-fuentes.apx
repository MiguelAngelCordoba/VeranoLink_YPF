page 13 (
    name: Fuentes
    alias: FUENTES
    title: Fuentes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region fuentes (
        name: Fuentes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'SOURCE' AS SOURCE_TYPE,
                       A.ID_VL_SOURCE AS ID,
                       A.SOURCE_URL,
                       TE.TYPE_ENVIRONMENT AS ENVIRONMENT,
                       C.NAME AS APPLICATION_NAME,
                       CASE WHEN A.VL_SOURCE_STATE = 1 THEN 'ACTIVO'
                            WHEN A.VL_SOURCE_STATE = 0 THEN 'INACTIVO' END AS ICON
                FROM VL_SOURCES A
                INNER JOIN VL_COMPANIES_SOURCE_APPLICATIONS B
                        ON A.ID_VL_COMPANY_APPLICATION = B.ID_VL_COMPANY_APPLICATION
                LEFT JOIN VL_SOURCE_APPLICATIONS C
                       ON B.ID_VL_SOURCE_APPLICATION = C.ID_VL_SOURCE_APPLICATION
                LEFT JOIN VL_TYPES_ENVIRONMENT TE
                       ON A.ID_VL_TYPE_ENVIRONMENT = TE.ID_VL_TYPE_ENVIRONMENT
                WHERE B.VL_ID_COMPANY = :GET_COMPANY
                UNION ALL
                SELECT 'SEQUENCE' AS SOURCE_TYPE,
                       S.ID_VL_SEQUENCE_SOURCE,
                       S.SOURCE_URL,
                       TE.TYPE_ENVIRONMENT AS ENVIRONMENT,
                       'Sequence Enterprise',
                       'ACTIVO'
                FROM VL_SEQUENCE_SOURCES S
                LEFT JOIN VL_TYPES_ENVIRONMENT TE
                       ON S.ENVIRONMENT = TE.ID_VL_TYPE_ENVIRONMENT
                ORDER BY SOURCE_URL, ENVIRONMENT
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 14
                items: {
                    P14_ID_VL_SOURCE: #ID##ID_VL_SOURCE#
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 5645299556413346
        }

        column APPLICATION_NAME (
            type: plainText
            heading {
                heading: Aplicación
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column ENVIRONMENT (
            type: plainText
            heading {
                heading: Environment
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column ICON (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column SOURCE_TYPE (
            type: plainText
            heading {
                heading: Source Type
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column SOURCE_URL (
            type: plainText
            heading {
                heading: URL
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Fuentes
        }

        savedReport 61545 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APPLICATION_NAME (
                sequence: 1
            )

            displayColumn ICON (
                sequence: 3
            )

            displayColumn SOURCE_URL (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @fuentes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 14
                clearCache: 14
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction da-actualizacion-fuentes (
        name: DA_ACTUALIZACION_FUENTES
        execution {
            sequence: 20
        }
        when {
            event: input
            selectionType: region
            region: @fuentes
        }
        config {
            buildOption: @commented-out
        }

        action plugin-de-danielh-toastrnotifications (
            action: plugin/toastrNotifications
            settings {
                type: success
                text: Fuentes Actualizadas.
                preventDuplicates: true
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction da-refresh (
        name: DA_REFRESH
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @fuentes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @fuentes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

