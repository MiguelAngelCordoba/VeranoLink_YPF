    dynamicAction da-update-state (
        name: DA_UPDATE_STATE
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P15_ACTIVE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    
                    
                    BEGIN
                    
                    
                    UPDATE VL_PATH_CONTEXTS SET STATE= 0 WHERE ID_VL_PATH_CONTEXT = :P15_COD_API;
                    COMMIT;
                    END;
                    ```
                itemsToSubmit: P15_COD_API
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P15_ACTIVE
                value: N
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    
                    
                    BEGIN
                    
                    
                    UPDATE VL_PATH_CONTEXTS SET STATE= 1 WHERE ID_VL_PATH_CONTEXT = :P15_COD_API;
                    COMMIT;
                    END;
                    ```
                itemsToSubmit: P15_COD_API
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P15_ACTIVE
                value: Y
            }
        )

    )

    process set-descrip (
        name: SET_descrip
        type: executeCode
        source {
            plsqlCode: SELECT PATH_DESCRIPTION INTO :P15_DESCR_API FROM VL_PATH_CONTEXTS WHERE ID_VL_PATH_CONTEXT = :P15_COD_API;
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 6664995263816030
        }
    )

    branch (
        name: EXECUTE_JAVASCRIPT
        execution {
            sequence: 20
        }
        behavior {
            target: {
                type: url
                url: javascript:apex.event.trigger(document,'IDIOM'); console.log("PreventError");
            }
        }
    )

)

