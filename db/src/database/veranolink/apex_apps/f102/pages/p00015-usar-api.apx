                    707
                    404
                    204
                ]
            }
        )

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 16
                    items: {
                        P16_NAME_VIEW: &P15_API_RESPONSE.
                        P16_ID_API: &P15_COD_API.
                    }
                }
                options: submitPageItemsBeforeRedirect
                pageItemsToSubmit: [
                    P15_API_RESPONSE
                    P15_SAVE_DATA
                    P15_COD_API
                ]
            }
            execution {
                sequence: 250
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotInList
                item: P15_API_RESPONSE
