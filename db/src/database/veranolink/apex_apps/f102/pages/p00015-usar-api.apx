page 15 (
    name: Usar API
    alias: USAR-API
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        deepLinking: false
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
        browserCache: false
    }

    region clob (
        name: clob
        type: plugin/jsonRegion2
        source {
            text: P15_SAVE_DATA
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        plugin-jsonSchema {
            source: sqlQuery
            sqlQuery: SELECT JSON_P FROM VL_PATH_CONTEXTS WHERE ID_VL_PATH_CONTEXT = :P15_COD_API
        }
        plugin-layout {
            columnWidth: 12
            headers: true
        }
        plugin-jsonData {
            removeNullsFromJson: false
        }
    )

    pageItem P15_ACTIVE (
        type: switch
        label {
            label: Activado
            alignment: left
        }
        layout {
            sequence: 10
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: SELECT CASE VPC.STATE WHEN  1 THEN 'Y' WHEN  0 THEN 'N' end FROM VL_PATH_CONTEXTS vpc WHERE VPC.ID_VL_PATH_CONTEXT = :P15_COD_API
            used: always
        }
    )

    pageItem P15_API_RESPONSE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        source {
            used: always
        }
    )

    pageItem P15_COD_API (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P15_DESCR_API (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 30
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P15_SAVE_DATA (
        type: textarea
        label {
            label: New
            alignment: left
        }
        layout {
            sequence: 50
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        sessionState {
            storage: request
        }
    )

    button ejecutar (
        buttonName: Ejecutar
        label: Ejecutar
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction da-execute-validations (
        name: DA_EXECUTE_VALIDATIONS
        execution {
            sequence: 60
            eventScope: dynamic
            type: debounce
            time: 3000
            immediate: true
        }
        when {
            event: custom
            customEvent: IDIOM
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    GET_RESPONSE VARCHAR2(1000);
                    
                    BEGIN
                    
                    
                    
                    GET_RESPONSE := VL_PKG_REST_SERVICES.VL_EXTRACT_API_RESPONSE(iv_param_json =>:P15_SAVE_DATA
                                                      ,iv_cod_context => :P15_COD_API
                                                      ,iv_company_name => :GET_COMPANY_NAME
                                                      , iv_environment => :APPLICATION_ENVIRONMENT);
                    
                    
                    
                    :P15_API_RESPONSE := GET_RESPONSE;
                    
                    END;
                    ```
                itemsToSubmit: [
                    P15_SAVE_DATA
                    P15_COD_API
                    GET_COMPANY_NAME
                    APPLICATION_ENVIRONMENT
                ]
                itemsToReturn: P15_API_RESPONSE
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: console.log("asdas")
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                spinnerType: roller
                accessibilityText: Processing
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                spinnerType: roller
                accessibilityText: Processing
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction da-notification (
        name: DA_NOTIFICATION
        execution {
            sequence: 80
            eventScope: dynamic
        }
        when {
            selectionType: items
            items: P15_API_RESPONSE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    
                    :GET_JSON_REQUEST:= :P15_SAVE_DATA;
                    
                    END;
                    ```
                itemsToSubmit: P15_SAVE_DATA
                itemsToReturn: GET_JSON_REQUEST
                showProcessing: true
            }
            execution {
                sequence: 240
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotInList
                item: P15_API_RESPONSE
                list: [
                    602
                    603
                    1039
                    1049
                    1074
                    657
                    811
                    2051
                    500
                    713
                    3000
                    505
                    709
                    1059
                    1305
