    region nombre-de-la-tabla (
        name: Nombre de la tabla
        type: staticContent
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @inline-popup
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-popup-callout
                js-dialog-size600x400
                js-popup-pos-after
            ]
            cssClasses: table_name
            renderComponents: belowContent
        }
        advanced {
            htmlDomId: table_name
            customAttributes: data-parent-element="#savetable"
        }
    )

    pageItem P12_COLUMNS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            slot: body
        }
        source {
            used: always
        }
    )

    pageItem P12_COLUMNS_VIEW (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            slot: body
        }
        source {
            type: item
            item: VIEW_QUERY
            used: always
        }
    )

    pageItem P12_CREATE_RESPONSE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @nombre-de-la-tabla
            slot: regionBody
        }
    )

    pageItem P12_ID_API (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            slot: body
        }
    )

    pageItem P12_ITEM_FOR_PREVENT_SUBMIT (
        type: textField
        label {
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 110
            slot: body
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: style="display:none"
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P12_NAME_TABLE (
        type: textField
        label {
            label: Nombre para la tabla
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @nombre-de-la-tabla
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P12_NAME_VIEW (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: body
        }
        source {
            used: always
        }
    )

    button guardar (
        buttonName: Guardar
        label: Guardar como tabla
        layout {
            sequence: 10
            region: @columnas-seleccionadas
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: savetable
        }
    )

    button save (
        buttonName: save
        label: Guardar y visualizar tabla
        layout {
            sequence: 40
            region: @nombre-de-la-tabla
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button volver (
        buttonName: Volver
        label: Volver
        layout {
            sequence: 10
            region: @columnas-seleccionadas
            slot: copy
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction da-create-table (
        name: DA_CREATE_TABLE
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @save
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    validator number;
                    BEGIN
                    
                    
                    select COUNT(*) INTO VALIDATOR from all_tables where owner = :GET_COMPANY_NAME AND TABLE_NAME = UPPER(:P12_NAME_TABLE);
                    
                    
                    IF REGEXP_LIKE(:P12_NAME_TABLE,'^[a-zA-Z_-]*$') THEN 
                    IF validator = 0 THEN 
                        :P12_CREATE_RESPONSE := 0;
                    ELSE
                        :P12_CREATE_RESPONSE := 1;
                     END IF;
                    
                     ELSE 
                     :P12_CREATE_RESPONSE := 2;
                     END IF;
                    END;
                    ```
                itemsToSubmit: P12_NAME_TABLE
                itemsToReturn: P12_CREATE_RESPONSE
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction da-notification (
        name: DA_NOTIFICATION
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P12_CREATE_RESPONSE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    VL_PKG_TABLE_FROM_VIEW.CREATE_TABLE(:P12_ID_API,:GET_COMPANY_NAME,upper(:P12_NAME_TABLE),TO_CLOB(:P12_COLUMNS),:P12_NAME_VIEW,:GET_ID,:GET_JSON_REQUEST,:APPLICATION_ENVIRONMENT);
                    
                    -- EXCEPTION
                    
                    
                    --       WHEN OTHERS THEN IF SQLCODE = -00903 then 
                    --       :P12_CREATE_RESPONSE := 3;
                    --       end if;
                    
                    END;
                    ```
                itemsToSubmit: [
                    GET_COMPANY_NAME
                    P12_NAME_TABLE
                    P12_COLUMNS
                    P12_NAME_VIEW
                ]
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P12_CREATE_RESPONSE
                value: 0
            }
        )

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 18
                }
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P12_CREATE_RESPONSE
                value: 0
            }
        )

        action plugin-de-danielh-toastrnotifications (
            action: plugin/toastrNotifications
            settings {
                type: error
                text: Esta tabla ya existe
                preventDuplicates: true
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P12_CREATE_RESPONSE
                value: 1
            }
        )

        action plugin-de-danielh-toastrnotifications-2 (
            action: plugin/toastrNotifications
            settings {
                type: error
                text: El nombre no puede tener espacios ni numeros
                preventDuplicates: true
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P12_CREATE_RESPONSE
                value: 2
            }
        )

        action plugin-de-danielh-toastrnotifications-3 (
            action: plugin/toastrNotifications
            settings {
                type: error
                text: Nombre de tabla inválido
                preventDuplicates: true
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P12_CREATE_RESPONSE
                value: 3
            }
        )

        action plugin-de-danielh-toastrnotifications-4 (
            action: plugin/toastrNotifications
            settings {
                type: success
                text: Tabla creada exitosamente!
                preventDuplicates: true
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P12_CREATE_RESPONSE
                value: 0
            }
        )

    )

    dynamicAction da-open-region-save (
        name: DA_OPEN_REGION_SAVE
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @guardar
        }

        action native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @nombre-de-la-tabla
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction da-set-query (
        name: DA_SET_QUERY
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    
                    v_query varchar2(4000);
                    BEGIN
                    v_query:= 'select "' || REPLACE ( :P12_COLUMNS_VIEW ,':','","')||'" ' ||' from '||'"VERANOLINK"."'||:P12_NAME_VIEW||'" ';
                    :P12_COLUMNS :=v_query ;
                    
                    
                    
                    
                    
                    END;
                    
                    
                    ```
                itemsToSubmit: [
                    P12_COLUMNS_VIEW
                    P12_NAME_VIEW
                ]
                itemsToReturn: P12_COLUMNS
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @columnas-seleccionadas
            }
            execution {
                sequence: 40
            }
        )

    )

    dynamicAction da-to-back (
        name: DA_TO_BACK
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @volver
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.history.back();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

