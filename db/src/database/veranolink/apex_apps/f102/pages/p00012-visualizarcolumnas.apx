page 12 (
    name: Visualizar columnas
    alias: VISUALIZARCOLUMNAS
    title: Visualizar columnas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .table_name{
                height: auto;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region columnas-seleccionadas (
        name: Columnas seleccionadas
        type: classicReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                
                
                BEGIN
                return :P12_COLUMNS;
                
                END;
                ```
            pageItemsToSubmit: P12_COLUMNS
            useGenericColumnNames: true
            genericColumnCount: 80
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region-orderBy--center
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
            displayPosition: topLeft
        }
        messages {
            whenNoDataFound: a
        }
        heading {
            type: columnNames
        }

