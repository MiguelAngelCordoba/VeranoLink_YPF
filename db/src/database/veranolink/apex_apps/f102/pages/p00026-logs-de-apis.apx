    region detail (
        name: Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    ID_LOG AS ID_LOG,
                    vpc.name AS "Api Usada",
                    COMPANY_SHORTNAME AS "Companny Shortname",
                    VL_AUDIT_LOG AS "Codigo Log",
                    VL_LOG_DESCRIPTION AS "Descripcion del Log",
                    TO_CHAR(VL_TIMESTAMP, 'DD-MM-YYYY HH:MI:SS AM') AS "Fecha de ejecucion",
                    
                
                    CASE 
                        WHEN VL_STATUS_CODE IN (0, 1) THEN 'Procesamiento interno'
                        ELSE VL_METHOD
                    END AS "Metodo",
                    VL_APLICATION AS "Aplicacion",
                    VL_SIZE AS "Size",
                    CASE
                        WHEN VL_STATUS_CODE = 0 OR VL_STATUS_CODE = 1 THEN
                            NULL
                        ELSE
                            VL_STATUS_CODE
                    END AS "Codigo de retorno",
                    CASE
                        WHEN VL_PARAMETERS IS NOT NULL THEN DBMS_LOB.GETLENGTH(VL_PARAMETERS)
                        ELSE 0
                    END AS "BBLOB_LENGTH",
                    '<div>' || 
                    CASE 
                        WHEN DBMS_LOB.GETLENGTH(VL_PARAMETERS) > 120000 THEN
                            '<div class="cc-actions-column">
                                <span>
                                    <a href="' || APEX_PAGE.GET_URL(
                                        p_page   => 0,
                                        p_items  => 'ID_PARAMETER',
                                        p_values => ID_LOG,
                                        p_request => 'APPLICATION_PROCESS=DOWNLOAD_JSON'
                                    ) || '" aria-hidden="false" class="fa fa-download t-Button t-Button--simple cc-download-btn" data-id="' || ID_LOG || '"></a>
                                </span>
                            </div>'
                        WHEN VL_PARAMETERS IS NOT NULL THEN
                            '<div class="cc-actions-column">
                                <span>
                                    <a href="##" aria-hidden="false" class="fa fa-eye t-Button t-Button--simple cc-clear-btn" data-id="' || ID_LOG || '"></a>
                                </span>
                            </div>'
                        ELSE 
                            'No se genera JSON'
                    END ||
                    '</div>'  ||CASE 
                        WHEN ROW_NUMBER() OVER (PARTITION BY VL_AUDIT_LOG ORDER BY VL_TIMESTAMP ASC) = 1 THEN
                            '<tr><td colspan="8" class="grupo-titulo">Grupo: ' || VL_AUDIT_LOG || '</td></tr>'
                        ELSE 
                            NULL
                END AS "LINK_VL_PARAMETERS"
                
                FROM VL_LOGS vlg
                LEFT JOIN VL_PATH_CONTEXTS vpc
                    ON vlg.id_vl_path_context = vpc.id_vl_path_context
                WHERE (COMPANY_SHORTNAME = 'EPM' AND VL_NAME_API = :P26_NAME_API) 
                   OR (VL_AUDIT_LOG = :P26_VL)
                ORDER BY VL_TIMESTAMP DESC;
                
                ```
            pageItemsToSubmit: [
                P26_VL
                P26_LOG
                P26_NAME_API
            ]
        }
