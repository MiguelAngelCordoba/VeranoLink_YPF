    dynamicAction busqueda-api (
        name: Busqueda API
        execution {
            sequence: 90
        }
        when {
            event: keyup
            selectionType: items
            items: P26_BUSQUEDA
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: this.browserEvent.which === apex.jQuery.ui.keyCode.ENTER
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P26_BUSQUEDA
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction openjsonview (
        name: OpenJsonView
        execution {
            sequence: 10
            eventScope: dynamic
            staticContainer: #Detail_r
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .cc-clear-btn
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      var parameterValue = $v("P26_VL_PARAMETERS");
                    
                      $(".my_json_item").empty(); // Limpiar contenido previo
                    
                      if (!parameterValue || parameterValue.trim() === "") {
                        document.querySelector(".my_json_item").textContent = "No se usaron parámetros.";
                        
                      } else {
                        document.querySelector(".my_json_item").textContent = parameterValue;
                        $("cc-clear-btn").hide();
                        try {
                          var json = JSON.parse(parameterValue);
                    
                        
                          $(".my_json_item").JSONView(json, { collapsed: true }); 
                    
                          
                          $("#expandBtn").on("click", function (event) {
                            event.preventDefault(); 
                            $(".my_json_item").JSONView('expand'); // Expande todo el JSON
                          });
                    
                     
                          $("#collapseBtn").on("click", function (event) {
                            event.preventDefault(); 
                            $(".my_json_item").JSONView('collapse'); // Colapsa todo el JSON
                          });
                         
                        } catch (e) {
                          console.error("El valor no es un JSON válido:", e);
                        }
                      }
                    })();
                    
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function() {
                      var parameterValue = $v("P26_VL_PARAMETERS");
                    
                      $(".my_json_item").empty();
                    
                    
                      if (!parameterValue || parameterValue.trim() === "") {
                        document.querySelector(".my_json_item").textContent = "No se usaron parámetros.";
                      } else {
                        // Asigna el valor a la región <pre>
                        document.querySelector(".my_json_item").textContent = parameterValue;
                    
                        try {
                          // Intentar formatear el JSON
                          var json = JSON.parse(parameterValue);
                          $(".my_json_item").JSONView(json, { collapsed: false });
                        } catch (e) {
                          console.error("El valor no es un JSON válido:", e);
                        }
                      }
                    })();
                    
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @view-json
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression:
                    ```javascript-browser
                    $(this.triggeringElement).data('id');
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P26_LOG
            }
            execution {
                sequence: 20
            }
        )

