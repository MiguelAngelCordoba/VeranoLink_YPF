    region logs-de-apis (
        name: Logs de APIS
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    MIN(ID_LOG) AS ID_LOG,
                    
                    MIN(VL_AUDIT_LOG) AS LINK_CLASS,
                    NULL AS ICON_CLASS,
                    NULL AS LINK_ATTR,
                    NULL AS ICON_COLOR_CLASS,
                    NULL AS LIST_CLASS,
                    apex_page.get_url(p_items => 'P26_NAME_API,P26_VL', p_values => MIN(VL_NAME_API) || ',' || MIN(VL_AUDIT_LOG)) AS LINK,
                
                    SUBSTR(MIN(VL_NAME_API), 1, 60) || 
                    CASE 
                        WHEN LENGTH(MIN(VL_NAME_API)) > 60 THEN '...' 
                        ELSE '' 
                    END AS LIST_TITLE,
                    
                   'Última sincronización: ' || TO_CHAR(MAX(VL_TIMESTAMP), 'DD-MM-YYYY HH:MI:SS AM') AS LIST_TEXT,
                
                    
                    SUBSTR(MIN(VL_AUDIT_LOG), 1, 50) || 
                    CASE 
                        WHEN LENGTH(MIN(VL_AUDIT_LOG)) > 50 THEN '...' 
                        ELSE '' 
                    END AS LIST_TEXT_2,
                
                    NULL AS LIST_BADGE
                FROM
                    VL_LOGS v_log
                LEFT JOIN VL_PATH_CONTEXTS vpc
                    ON v_log.ID_VL_PATH_CONTEXT = vpc.ID_VL_PATH_CONTEXT
                WHERE
                    COMPANY_SHORTNAME = :GET_COMPANY_NAME AND (
                        :P26_BUSQUEDA IS NULL
                        OR UPPER(v_log.VL_NAME_API) LIKE '%' || UPPER(:P26_BUSQUEDA) || '%'
                    ) 
                GROUP BY
                    VL_NAME_API
                ORDER BY
                    MAX(VL_TIMESTAMP) DESC;
                
                ```
            pageItemsToSubmit: [
                P26_LOG
                P26_BUSQUEDA
                P26_NAME_API
                P26_VL
            ]
        }
