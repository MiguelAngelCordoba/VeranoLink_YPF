page 5 (
    name: Mi perfil
    alias: MI-PERFIL
    title: Mi perfil
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region mi-perfil (
        name: Mi perfil
        type: form
        source {
            location: localDatabase
            tableName: VL_USERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region region-botones (
        name: Region Botones
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P5_EMAIL (
        type: displayOnly
        label {
            label: Correo Electrónico
            alignment: left
        }
        layout {
            sequence: 30
            region: @mi-perfil
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @mi-perfil
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P5_NAME (
        type: textField
        label {
            label: Nombre
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @mi-perfil
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @mi-perfil
            column: NAME
            dataType: varchar2
        }
    )

    pageItem P5_VL_ID_COMPANY (
        type: displayOnly
        label {
            label: Compañia
            alignment: left
        }
        settings {
            basedOn: lov
        }
        lov {
            type: sharedComponent
            lov: @vl-companies-name
        }
        layout {
            sequence: 40
            region: @mi-perfil
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @mi-perfil
            column: VL_ID_COMPANY
            dataType: number
        }
    )

    pageItem P5_VL_ID_ROL (
        type: displayOnly
        label {
            label: Rol
            alignment: left
        }
        settings {
            basedOn: lov
        }
        lov {
            type: sharedComponent
            lov: @vl-roles-name
        }
        layout {
            sequence: 70
            region: @mi-perfil
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @mi-perfil
            column: VL_ID_ROL
            dataType: number
        }
    )

    pageItem P5_VL_ID_USER (
        type: hidden
        layout {
            sequence: 10
            region: @mi-perfil
            slot: regionBody
        }
        source {
            formRegion: @mi-perfil
            column: VL_ID_USER
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button actualizar (
        buttonName: Actualizar
        label: Actualizar
        layout {
            sequence: 20
            region: @region-botones
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_VL_ID_USER
        }
    )

    button actualizar-contraseña (
        buttonName: Actualizar_contraseña
        label: Actualizar Contraseña
        layout {
            sequence: 10
            region: @region-botones
            slot: next
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 2
                items: {
                    P2_VL_ID_USER: &P5_VL_ID_USER.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @region-botones
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction da-cancel-dialog (
        name: DA_CANCEL_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process apclosedialog (
        name: apCloseDialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 3342433310695823
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process approcessformmiperfil (
        name: apProcessFormMiPerfil
        type: formAutoRowProcessing
        formRegion: @mi-perfil
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3342094678695823
        }
    )

    process initialize-form-mi-perfil (
        name: Initialize form Mi perfil
        type: formInitialization
        formRegion: @mi-perfil
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3341699374695823
        }
    )

)

