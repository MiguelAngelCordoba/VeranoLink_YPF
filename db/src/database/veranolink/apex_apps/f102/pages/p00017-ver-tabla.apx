    pageItem P17_NAME_TABLE (
        type: hidden
        layout {
            sequence: 30
            slot: body
        }
    )

    pageItem P17_QUERY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: body
        }
    )

    pageItem P17_RESPONSE_SYNC (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            slot: body
        }
        source {
            used: always
        }
    )

    button btn-sync-table (
        buttonName: BTN_SYNC_TABLE
        label: Sincronizar Tabla
        layout {
            sequence: 40
            region: @ver-tabla-seleccionada-p17-name-table
            slot: copy
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button eliminar-tabla (
        buttonName: ELIMINAR_TABLA
        label: Eliminar Tabla
        layout {
            sequence: 30
            region: @ver-tabla-seleccionada-p17-name-table
            slot: copy
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            action: definedByDynamicAction
            requiresConfirmation: true
        }
        confirmation {
            message: ¿Seguro que desea eliminar esta tabla?
        }
    )

    button volver-b (
        buttonName: Volver_b
        label: Volver
        layout {
            sequence: 10
            region: @ver-tabla-seleccionada-p17-name-table
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction da-delete (
        name: DA_DELETE
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @eliminar-tabla
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_query VARCHAR2(1000);
                    BEGIN
                    v_query := 'DROP TABLE "'||:GET_COMPANY_NAME ||'"."'||:P17_NAME_TABLE||'"';
                    EXECUTE IMMEDIATE V_QUERY;
                    
                    DELETE FROM VL_SAVED_TABLES WHERE TABLE_NAME = :P17_NAME_TABLE;
                    COMMIT;
                    END;
                    ```
                itemsToSubmit: P17_NAME_TABLE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 18
                    clearCache: 18
                    action: resetRegions
                }
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction da-open-modal (
        name: DA_OPEN_MODAL
        execution {
            sequence: 40
            eventScope: dynamic
        }
        when {
            selectionType: items
            items: P17_RESPONSE_SYNC
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 30
                    items: {
                        P30_RESPONSE_SYNC: &P17_RESPONSE_SYNC.
                        P30_TABLE_NAME: &P17_NAME_TABLE.
                    }
                }
                options: submitPageItemsBeforeRedirect
                pageItemsToSubmit: [
                    P17_NAME_TABLE
                    P17_RESPONSE_SYNC
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction da-set-query (
        name: DA_SET_QUERY
        execution {
            sequence: 10
            eventScope: dynamic
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    
                    v_query varchar2(4000);
                    BEGIN
                    v_query:= 'select * from '||'"'||:GET_COMPANY_NAME||'"."'||:P17_NAME_TABLE||'" ORDER BY NULL';
                    :P17_QUERY :=v_query ;
                    
                    END;
                    
                    
                    ```
                itemsToSubmit: P17_NAME_TABLE
                itemsToReturn: P17_QUERY
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ver-tabla-seleccionada-p17-name-table
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction da-valid-sync (
        name: DA_VALID_SYNC
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @btn-sync-table
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_count_validator NUMBER;
                    v_encode VARCHAR2(4000);
                    BEGIN
                    v_encode:= VL_PKG_UTL_BASE64.ENCODE_NUMBER_TO_BASE64(:GET_ID);
                    
                    select count(*) into v_count_validator from  user_scheduler_jobs  where JOB_NAME = (v_encode)||'_'||:P17_NAME_TABLE;
                    IF v_count_validator = 0 THEN 
                    :P17_RESPONSE_SYNC := 0;
                    ELSE
                    :P17_RESPONSE_SYNC:= 1;
                    END IF;
                    
                    END;
                    ```
                itemsToSubmit: P17_NAME_TABLE
