page 17 (
    name: Ver Tabla
    alias: VER-TABLA
    title: Ver Tabla
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ver-tabla-seleccionada-p17-name-table (
        name: Ver tabla seleccionada: &P17_NAME_TABLE.
        type: classicReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                
                RETURN :P17_QUERY;
                end;
                ```
            pageItemsToSubmit: P17_QUERY
            useGenericColumnNames: true
            genericColumnCount: 100
