customAttribute attribute_01 (
    apexlangName: type
    attribute: 1
    name: Type
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: info
    }
    help {
        helpText: Select the type of the notification. This preferences controls the color.
    }

    entry error (
        sequence: 40
        display: Error
        return: error
    )

    entry info (
        sequence: 10
        display: Info
        return: info
    )

    entry success (
        sequence: 20
        display: Success
        return: success
    )

    entry warning (
        sequence: 30
        display: Warning
        return: warning
    )

)

customAttribute attribute_02 (
    apexlangName: text
    attribute: 2
    name: Text
    type: textarea
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    builder {
        translatable: true
    }
    help {
        helpText: Enter the text which is displayed in the notification. Page-Items &P100_ITEM_NAME. can be used.
    }
)

customAttribute attribute_03 (
    apexlangName: position
    attribute: 3
    name: Position
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    default {
        value: toast-top-right
    }
    help {
        helpText: Choose the position/location of the notification.
    }

    entry bottomFullWidth (
        sequence: 60
        display: Bottom Full Width
        return: toast-bottom-full-width
    )

    entry bottomLeft (
        sequence: 40
        display: Bottom Left
        return: toast-bottom-left
    )

    entry bottomRight (
        sequence: 30
        display: Bottom Right
        return: toast-bottom-right
    )

    entry topFullWidth (
        sequence: 50
        display: Top Full Width
        return: toast-top-full-width
    )

    entry topLeft (
        sequence: 20
        display: Top Left
        return: toast-top-left
    )

    entry topRight (
        sequence: 10
        display: Top Right
        return: toast-top-right
    )

)

customAttribute attribute_04 (
    apexlangName: showCloseButton
    attribute: 4
    name: Show Close Button
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    default {
        value: true
    }
    help {
        helpText: Should a close button be displayed?
    }

    entry false (
        sequence: 20
        display: False
        return: false
    )

    entry true (
        sequence: 10
        display: True
        return: true
    )

)

customAttribute attribute_05 (
    apexlangName: newestOnTop
    attribute: 5
    name: Newest on top
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 50
    }
    default {
        value: true
    }
    help {
        helpText: When using multiple notifications on 1 page, should the newest be on top?
    }

    entry false (
        sequence: 20
        display: False
        return: false
    )

    entry true (
        sequence: 10
        display: True
        return: true
    )

)

customAttribute attribute_06 (
    apexlangName: showProgressBar
    attribute: 6
    name: Show Progress Bar
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 60
    }
    default {
        value: false
    }
    help {
        helpText: Show a progress bar to visualize the time when a notification disappears.
    }

    entry false (
        sequence: 20
        display: False
        return: false
    )

    entry true (
        sequence: 10
        display: True
        return: true
    )

)

customAttribute attribute_07 (
    apexlangName: preventDuplicates
    attribute: 7
    name: Prevent Duplicates
    type: selectList
    appearance {
        sequence: 70
    }
    default {
        value: true
    }
    help {
        helpText: Block notifications with the same text/content to display multiple times.
    }

    entry false (
        sequence: 20
        display: False
        return: false
    )

    entry true (
        sequence: 10
        display: True
        return: true
    )

)

customAttribute attribute_08 (
    apexlangName: showDuration
    attribute: 8
    name: Show Duration
    type: number
    appearance {
        sequence: 120
    }
    default {
        value: 300
    }
)

customAttribute attribute_09 (
    apexlangName: hideDuration
    attribute: 9
    name: Hide Duration
    type: number
    appearance {
        sequence: 130
    }
    default {
        value: 1000
    }
)

customAttribute attribute_10 (
    apexlangName: timeout
    attribute: 10
    name: Timeout
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 100
    }
    default {
        value: 5000
    }
    help {
        helpText: How long the toast will display without user interaction (in ms). A value of 0 makes a sticky notification.
    }
)

customAttribute attribute_11 (
    apexlangName: extendedTimeout
    attribute: 11
    name: Extended Timeout
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 110
    }
    default {
        value: 1000
    }
    help {
        helpText: How long the toast will display after a user hovers over it (in ms).
    }
)

